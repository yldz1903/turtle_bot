#!/opt/homebrew/bin/python3.11
"""Turtlesim için sürekli hareket eden duvardan kaçma (wanderer) düğümü.

Kaplumbağa HİÇBİR ZAMAN durmaz: linear.x her zaman > 0'dır.
"""
import math
import random

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from turtlesim.msg import Pose

# --- Parametreler ---
CENTER_X = 5.5
CENTER_Y = 5.5
SAFE_MIN = 2.0           # Güvenli bölge alt sınırı
SAFE_MAX = 9.0           # Güvenli bölge üst sınırı
EDGE_LINEAR = 1.5        # Duvara yakınken ileri hız (yine de durmaz)
TURN_GAIN = 4.5          # Merkeze dönüş kazancı
RESELECT_MIN = 1.5       # Rastgele hareketi yenileme aralığı (sn)
RESELECT_MAX = 2.0


class Wanderer(Node):
    def __init__(self):
        super().__init__('wanderer')
        self.sub = self.create_subscription(Pose, '/turtle1/pose', self.pose_cb, 10)
        self.pub = self.create_publisher(Twist, '/turtle1/cmd_vel', 10)
        # Rastgele yürüyüş durumu (güvenli bölgede kullanılır)
        self.rand_linear = random.uniform(1.5, 3.0)
        self.rand_angular = random.uniform(-2.5, 2.5)
        self.next_change = 0.0
        self.get_logger().info('Turtlesim Wanderer başladı, kaplumbağa hareket ediyor!')

    @staticmethod
    def normalize(angle):
        """Açıyı -pi ile +pi arasına getir."""
        while angle > math.pi:
            angle -= 2.0 * math.pi
        while angle < -math.pi:
            angle += 2.0 * math.pi
        return angle

    def pose_cb(self, pose):
        cmd = Twist()
        near_wall = (pose.x < SAFE_MIN or pose.x > SAFE_MAX or
                     pose.y < SAFE_MIN or pose.y > SAFE_MAX)
        if near_wall:
            # Duvara yaklaştı: durmadan merkeze (5.5, 5.5) doğru yönel
            # Küçük rastgele sapma: her seferinde aynı çizgiden dönmesin
            target_angle = (math.atan2(CENTER_Y - pose.y, CENTER_X - pose.x)
                            + random.uniform(-0.3, 0.3))
            angle_diff = self.normalize(target_angle - pose.theta)
            cmd.linear.x = EDGE_LINEAR
            cmd.angular.z = TURN_GAIN * angle_diff
        else:
            # Güvenli bölge: her 1.5-2 sn'de bir yeni rastgele hız ve dönüş seç
            now = self.get_clock().now().nanoseconds / 1e9
            if now >= self.next_change:
                self.rand_linear = random.uniform(1.5, 3.0)   # her zaman > 0
                self.rand_angular = random.uniform(-2.5, 2.5)
                self.next_change = now + random.uniform(RESELECT_MIN, RESELECT_MAX)
            cmd.linear.x = self.rand_linear
            cmd.angular.z = self.rand_angular
        if rclpy.ok():
            self.pub.publish(cmd)


def main(args=None):
    rclpy.init(args=args)
    node = Wanderer()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        # Context hâlâ geçerliyse kaplumbağayı durdur
        if rclpy.ok():
            node.pub.publish(Twist())
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
